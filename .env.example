# 复制为 .env 后按需修改：cp .env.example .env
# .env 不提交到 git。

# 跳转进程的监听地址。
ADDR=:8080
# 管理进程的监听地址。console 不读 ADDR，避免和跳转进程抢同一个端口。
CONSOLE_ADDR=:8081
DATABASE_URL=postgres://shortlink:shortlink@localhost:5432/shortlink?sslmode=disable

# 集成测试专用库；未设置时 postgres 测试会跳过。库名必须以 _test 结尾。
TEST_DATABASE_URL=postgres://shortlink:shortlink@localhost:5432/shortlink_test?sslmode=disable

# 集成测试专用 Redis；未设置时 cache 测试会跳过。测试只用自己的 test- 前缀 key。
TEST_REDIS_URL=redis://localhost:6379/0

# 连接池参数；不设置时使用代码里的默认值。
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m

# Redis 连接串。
REDIS_URL=redis://localhost:6379/0
# 访客哈希的 HMAC 密钥，redirector 启动时必填；console 不用。
# 盐是密钥，生产从密钥管理注入，不要提交真实值。这里是开发占位值。
VISITOR_SALT=dev-only-visitor-salt
# 只有部署在可信反向代理后面才设为 true；否则客户端可以伪造 X-Forwarded-For 刷高 UV。
TRUST_PROXY_HEADERS=false
# 日志级别：debug、info、warn、error；默认 info。
LOG_LEVEL=info
# 日志格式：text 或 json。本地默认 text；生产用 json，一行一条，方便采集。
LOG_FORMAT=text
# 单个请求的处理时限；到点后数据库调用被取消，客户端收到 504。
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
# 收到 SIGTERM 后，/readyz 先返回 503，等这么久再关监听。
# 要盖住编排器的一个探测周期；0s 表示不等。
# 容器的停止宽限要盖住它，再加上 SHUTDOWN_TIMEOUT 和点击排空。
DRAIN_DELAY=5s

# 普通缓存未命中时，进程内同时回源数据库的最大请求数；超出立即返回 503。
CACHE_MISS_CONCURRENCY=8
# 单次回源的超时，独立于 REQUEST_TIMEOUT；不能超过 REQUEST_TIMEOUT。
CACHE_FETCH_TIMEOUT=1s

# 剖析端点（/debug/pprof/）的监听地址，只有 redirector 读。默认不开。
# 只接受回环地址；剖析数据里有堆内容，端点没有鉴权。
# PPROF_ADDR=127.0.0.1:6060

# OIDC 登录配置，只有 console 读。四个都为空时不启用登录、会话与成员管理路由，只支持 API Key；只配一部分时启动失败。
# 本地开发对应 docker-compose 里的 Dex（deploy/dex.yaml，测试账号 alice@example.com / bob@example.com，密码均为 password）。
# OIDC_ISSUER=http://127.0.0.1:5556/dex
# OIDC_CLIENT_ID=shortlink-console
# OIDC_CLIENT_SECRET=shortlink-console-secret
# OIDC_REDIRECT_URL=http://127.0.0.1:8081/api/v1/auth/callback

# GitHub OAuth 2.0 登录配置，只有 console 读。可与 OIDC_* 独立或同时启用；三个都为空时不挂 GitHub 路由，只配一部分时启动失败。
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=http://127.0.0.1:8081/api/v1/auth/github/callback

# 可选前端静态资源目录（ADR 0021）。设置后 console 在 / 提供 SPA 页面，保留 /api/*、/r/*、/healthz、/readyz、/metrics 路由隔离。
# 先运行 make web-install && make web-build 生成 web/dist。
# WEB_DIST_DIR=web/dist
# 公开短链跳转基地址（仅 console 读，可选）。当 console 与 redirector 分端口/分域名部署时填写（如本地 http://127.0.0.1:8080），前端拼装短链与二维码将指向此地址，避免打到 console 404；单入口反向代理可留空。
# PUBLIC_BASE_URL=http://127.0.0.1:8080

# 后台任务进程（console worker）配置，按需取消注释覆盖默认值（ADR 0020）。
# WORKER_ADDR=127.0.0.1:8082
# WORKER_CONCURRENCY=8
# WORKER_MAX_PER_TENANT=4
# WORKER_POLL_INTERVAL=200ms
# WORKER_LEASE_DURATION=30s
# WORKER_JOB_TIMEOUT=20s
# WORKER_REAP_INTERVAL=15s
# WORKER_CLEANUP_INTERVAL=1h
# WORKER_SESSION_RETENTION=168h
# WORKER_DONE_JOB_RETENTION=168h
# RISK_FETCH_TIMEOUT=5s
# RISK_HOST_RATE_LIMIT=2
# RISK_BLOCKED_KEYWORDS=
