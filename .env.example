# 复制为 .env 后按需修改：cp .env.example .env
# .env 不提交到 git。

ADDR=:8080
DATABASE_URL=postgres://shortlink:shortlink@localhost:5432/shortlink?sslmode=disable

# 集成测试专用库；未设置时 postgres 测试会跳过。库名必须以 _test 结尾。
TEST_DATABASE_URL=postgres://shortlink:shortlink@localhost:5432/shortlink_test?sslmode=disable

# 集成测试专用 Redis；未设置时 cache 测试会跳过。测试只用自己的 test- 前缀 key。
TEST_REDIS_URL=redis://localhost:6379/0

# 连接池参数；不设置时使用代码里的默认值。
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m

# Redis 连接串。
REDIS_URL=redis://localhost:6379/0
# 单个请求的处理时限；到点后数据库调用被取消，客户端收到 504。
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
